{% render 'bfcm-assets' %}

<section class="bfcm bfcm--{{ section.settings.theme }}" {% if section.settings.anchor_id != blank %}id="{{ section.settings.anchor_id }}"{% endif %}>
  <div class="bfcm__inner">
    {% if section.settings.eyebrow != blank %}
      <p class="bfcm-kicker">{{ section.settings.eyebrow }}</p>
    {% endif %}
    <h2 class="bfcm-heading">{{ section.settings.heading }}</h2>
    {% if section.settings.text != blank %}
      <p class="bfcm-lead">{{ section.settings.text }}</p>
    {% endif %}
    {% if section.settings.email != blank or section.settings.phone != blank or section.settings.hours != blank %}
      <p class="bfcm-footnote">
        {% if section.settings.email != blank %}{{ section.settings.email }}{% endif %}
        {% if section.settings.phone != blank %} · {{ section.settings.phone }}{% endif %}
        {% if section.settings.hours != blank %}<br>{{ section.settings.hours }}{% endif %}
      </p>
    {% endif %}
    {% form 'contact', id: 'bfcm-contact' %}
      <div class="bfcm-form">
        {% if form.posted_successfully? %}
          <p>{{ section.settings.success }}</p>
        {% else %}
          {{ form.errors | default_errors }}
          <input type="text" name="contact[name]" autocomplete="name" placeholder="{{ section.settings.name_label }}" aria-label="{{ section.settings.name_label }}">
          <input type="email" name="contact[email]" autocomplete="email" required placeholder="{{ section.settings.email_label }}" aria-label="{{ section.settings.email_label }}">
          <textarea name="contact[body]" placeholder="{{ section.settings.message_label }}" aria-label="{{ section.settings.message_label }}"></textarea>
          <button class="bfcm-btn" type="submit">{{ section.settings.button_label }}</button>
        {% endif %}
      </div>
    {% endform %}
    {% if section.settings.disclaimer != blank %}
      <div class="bfcm-footnote bfcm-richtext">{{ section.settings.disclaimer }}</div>
    {% endif %}
  </div>
</section>

{% schema %}
{
  "name": "黑五联系",
  "tag": "div",
  "class": "bfcm-section",
  "settings": [
    { "type": "text", "id": "anchor_id", "label": "锚点 ID", "default": "contact" },
    {
      "type": "select",
      "id": "theme",
      "label": "配色",
      "options": [
        { "value": "dark", "label": "深色" },
        { "value": "light", "label": "浅色" },
        { "value": "paper", "label": "浅灰" }
      ],
      "default": "dark"
    },
    { "type": "text", "id": "eyebrow", "label": "眉题", "default": "Talk to us" },
    { "type": "text", "id": "heading", "label": "标题", "default": "Not sure which machine fits the job?" },
    { "type": "textarea", "id": "text", "label": "说明", "default": "Send a note and the store inbox receives it. This form does not sign anyone up for a separate mailing list." },
    { "type": "text", "id": "email", "label": "邮箱", "default": "cs@1laser.com" },
    { "type": "text", "id": "phone", "label": "电话" },
    { "type": "text", "id": "hours", "label": "服务时间" },
    { "type": "text", "id": "name_label", "label": "姓名占位", "default": "Name" },
    { "type": "text", "id": "email_label", "label": "邮箱占位", "default": "Email" },
    { "type": "text", "id": "message_label", "label": "留言占位", "default": "Tell us what you want to make" },
    { "type": "text", "id": "button_label", "label": "按钮", "default": "Send" },
    { "type": "text", "id": "success", "label": "成功提示", "default": "Message sent. We will reply by email." },
    { "type": "richtext", "id": "disclaimer", "label": "底部声明", "default": "<p>Financing estimates, if a payment app shows them at checkout, are not a credit offer. The provider decides approval, rates, and terms.</p>" }
  ],
  "presets": [
    { "name": "黑五联系", "category": "Black Friday" }
  ],
  "enabled_on": { "templates": ["page"] }
}
{% endschema %}
