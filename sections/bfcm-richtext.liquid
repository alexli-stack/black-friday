{% render 'bfcm-assets' %}

<section class="bfcm bfcm--{{ section.settings.theme }}" {% if section.settings.anchor_id != blank %}id="{{ section.settings.anchor_id }}"{% endif %}>
  <div class="bfcm__inner">
    {% if section.settings.eyebrow != blank %}
      <p class="bfcm-kicker">{{ section.settings.eyebrow }}</p>
    {% endif %}
    {% if section.settings.heading != blank %}
      <h2 class="bfcm-heading">{{ section.settings.heading }}</h2>
    {% endif %}
    {% if section.settings.text != blank %}
      <div class="bfcm-lead bfcm-richtext">{{ section.settings.text }}</div>
    {% endif %}
    {% if section.blocks.size > 0 %}
      <div class="bfcm-steps">
        {% for block in section.blocks %}
          <article class="bfcm-step" {{ block.shopify_attributes }}>
            {% if block.settings.kicker != blank %}
              <span>{{ block.settings.kicker }}</span>
            {% endif %}
            <h3>{{ block.settings.title }}</h3>
            {% if block.settings.text != blank %}
              <p>{{ block.settings.text }}</p>
            {% endif %}
          </article>
        {% endfor %}
      </div>
    {% endif %}
  </div>
</section>

{% schema %}
{
  "name": "黑五说明",
  "tag": "div",
  "class": "bfcm-section",
  "settings": [
    { "type": "text", "id": "anchor_id", "label": "锚点 ID" },
    {
      "type": "select",
      "id": "theme",
      "label": "配色",
      "options": [
        { "value": "dark", "label": "深色" },
        { "value": "light", "label": "浅色" },
        { "value": "paper", "label": "浅灰" }
      ],
      "default": "light"
    },
    { "type": "text", "id": "eyebrow", "label": "眉题" },
    { "type": "text", "id": "heading", "label": "标题", "default": "How setup help works" },
    { "type": "richtext", "id": "text", "label": "正文", "default": "<p>Rewrite this so it matches the service you actually offer.</p>" }
  ],
  "blocks": [
    {
      "type": "step",
      "name": "步骤",
      "settings": [
        { "type": "text", "id": "kicker", "label": "序号", "default": "01" },
        { "type": "text", "id": "title", "label": "标题", "default": "Confirm the order" },
        { "type": "textarea", "id": "text", "label": "说明", "default": "After checkout, watch for an email to confirm the service." }
      ]
    }
  ],
  "max_blocks": 6,
  "presets": [
    { "name": "黑五说明", "category": "Black Friday" }
  ],
  "enabled_on": { "templates": ["page"] }
}
{% endschema %}
