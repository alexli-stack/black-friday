{% render 'bfcm-assets' %}

<section class="bfcm bfcm--{{ section.settings.theme }}" {% if section.settings.anchor_id != blank %}id="{{ section.settings.anchor_id }}"{% endif %}>
  <div class="bfcm__inner">
    {% if section.settings.eyebrow != blank %}
      <p class="bfcm-kicker">{{ section.settings.eyebrow }}</p>
    {% endif %}
    <h2 class="bfcm-heading">{{ section.settings.heading }}</h2>
    {% if section.settings.text != blank %}
      <p class="bfcm-lead">{{ section.settings.text }}</p>
    {% endif %}
    <div class="bfcm-stories">
      {% for block in section.blocks %}
        <article class="bfcm-story" {{ block.shopify_attributes }}>
          <div class="bfcm-story__media">
            {% if block.settings.image != blank %}
              {{ block.settings.image | image_url: width: 800 | image_tag: widths: '240, 480, 800', sizes: '220px', loading: 'lazy', alt: block.settings.title }}
            {% elsif block.settings.product != blank %}
              {% if block.settings.product.featured_image != blank %}
                {{ block.settings.product.featured_image | image_url: width: 800 | image_tag: widths: '240, 480, 800', sizes: '220px', loading: 'lazy', alt: block.settings.product.title }}
              {% endif %}
            {% endif %}
          </div>
          <div class="bfcm-story__body">
            {% if block.settings.kicker != blank %}
              <p class="bfcm-kicker">{{ block.settings.kicker }}</p>
            {% endif %}
            <h3>{{ block.settings.title }}</h3>
            {% if block.settings.text != blank %}
              <p>{{ block.settings.text }}</p>
            {% endif %}
            {% if block.settings.link_label != blank %}
              <div class="bfcm-actions">
                <a class="bfcm-btn" href="{% if block.settings.product != blank %}{{ block.settings.product.url }}{% else %}{{ block.settings.link }}{% endif %}">{{ block.settings.link_label }}</a>
              </div>
            {% endif %}
          </div>
        </article>
      {% endfor %}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "黑五配件故事",
  "tag": "div",
  "class": "bfcm-section",
  "settings": [
    { "type": "text", "id": "anchor_id", "label": "锚点 ID", "default": "stories" },
    {
      "type": "select",
      "id": "theme",
      "label": "配色",
      "options": [
        { "value": "dark", "label": "深色" },
        { "value": "light", "label": "浅色" },
        { "value": "paper", "label": "浅灰" }
      ],
      "default": "paper"
    },
    { "type": "text", "id": "eyebrow", "label": "眉题", "default": "Accessories" },
    { "type": "text", "id": "heading", "label": "标题", "default": "Build the rest of the setup" },
    { "type": "textarea", "id": "text", "label": "说明" }
  ],
  "blocks": [
    {
      "type": "story",
      "name": "故事",
      "settings": [
        { "type": "text", "id": "kicker", "label": "眉题" },
        { "type": "text", "id": "title", "label": "标题", "default": "Rotary engraving" },
        { "type": "textarea", "id": "text", "label": "说明" },
        { "type": "text", "id": "link_label", "label": "按钮", "default": "View" },
        { "type": "text", "id": "link", "label": "链接", "info": "选择商品后，按钮打开商品页。" },
        { "type": "product", "id": "product", "label": "商品" },
        { "type": "image_picker", "id": "image", "label": "自定义图片" }
      ]
    }
  ],
  "max_blocks": 8,
  "presets": [
    { "name": "黑五配件故事", "category": "Black Friday" }
  ],
  "enabled_on": { "templates": ["page"] }
}
{% endschema %}
