{% render 'bfcm-assets' %}

<section class="bfcm bfcm--{{ section.settings.theme }}" {% if section.settings.anchor_id != blank %}id="{{ section.settings.anchor_id }}"{% endif %}>
  <div class="bfcm__inner">
    {% if section.settings.eyebrow != blank %}
      <p class="bfcm-kicker">{{ section.settings.eyebrow }}</p>
    {% endif %}
    <h2 class="bfcm-heading">{{ section.settings.heading }}</h2>
    {% if section.settings.text != blank %}
      <p class="bfcm-lead">{{ section.settings.text }}</p>
    {% endif %}
    <div class="bfcm-scroll">
      <table>
        <thead>
          <tr>
            <th scope="col">{{ section.settings.corner }}</th>
            {% for block in section.blocks %}
              <th scope="col" {{ block.shopify_attributes }}>
                {% if block.settings.product != blank %}
                  <a href="{{ block.settings.product.url }}">{{ block.settings.product.title }}</a>
                {% else %}
                  {{ block.settings.title }}
                {% endif %}
              </th>
            {% endfor %}
          </tr>
        </thead>
        <tbody>
          {% if section.settings.row_summary != blank %}
            <tr>
              <th scope="row">{{ section.settings.row_summary }}</th>
              {% for block in section.blocks %}
                <td>{{ block.settings.summary | default: '—' }}</td>
              {% endfor %}
            </tr>
          {% endif %}
          {% if section.settings.row_1 != blank %}
            <tr>
              <th scope="row">{{ section.settings.row_1 }}</th>
              {% for block in section.blocks %}
                <td>{{ block.settings.value_1 | default: '—' }}</td>
              {% endfor %}
            </tr>
          {% endif %}
          {% if section.settings.row_2 != blank %}
            <tr>
              <th scope="row">{{ section.settings.row_2 }}</th>
              {% for block in section.blocks %}
                <td>{{ block.settings.value_2 | default: '—' }}</td>
              {% endfor %}
            </tr>
          {% endif %}
          {% if section.settings.row_3 != blank %}
            <tr>
              <th scope="row">{{ section.settings.row_3 }}</th>
              {% for block in section.blocks %}
                <td>{{ block.settings.value_3 | default: '—' }}</td>
              {% endfor %}
            </tr>
          {% endif %}
          {% if section.settings.row_4 != blank %}
            <tr>
              <th scope="row">{{ section.settings.row_4 }}</th>
              {% for block in section.blocks %}
                <td>{{ block.settings.value_4 | default: '—' }}</td>
              {% endfor %}
            </tr>
          {% endif %}
        </tbody>
      </table>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "黑五机型对比",
  "tag": "div",
  "class": "bfcm-section",
  "settings": [
    { "type": "text", "id": "anchor_id", "label": "锚点 ID", "default": "compare" },
    {
      "type": "select",
      "id": "theme",
      "label": "配色",
      "options": [
        { "value": "dark", "label": "深色" },
        { "value": "light", "label": "浅色" },
        { "value": "paper", "label": "浅灰" }
      ],
      "default": "paper"
    },
    { "type": "text", "id": "eyebrow", "label": "眉题", "default": "Compare" },
    { "type": "text", "id": "heading", "label": "标题", "default": "Which machine is right for you?" },
    { "type": "textarea", "id": "text", "label": "说明", "default": "A short comparison. Open the product page for the full specification." },
    { "type": "text", "id": "corner", "label": "表头空列", "default": "Quick look" },
    { "type": "text", "id": "row_summary", "label": "摘要行名称", "default": "Summary" },
    { "type": "text", "id": "row_1", "label": "第 1 行", "default": "Laser" },
    { "type": "text", "id": "row_2", "label": "第 2 行", "default": "Format" },
    { "type": "text", "id": "row_3", "label": "第 3 行", "default": "Best for" },
    { "type": "text", "id": "row_4", "label": "第 4 行", "default": "Work area", "info": "某一行留空就会整行隐藏。" }
  ],
  "blocks": [
    {
      "type": "machine",
      "name": "机型",
      "settings": [
        { "type": "product", "id": "product", "label": "商品" },
        { "type": "text", "id": "title", "label": "无商品时的标题" },
        { "type": "textarea", "id": "summary", "label": "摘要" },
        { "type": "text", "id": "value_1", "label": "第 1 行内容" },
        { "type": "text", "id": "value_2", "label": "第 2 行内容" },
        { "type": "text", "id": "value_3", "label": "第 3 行内容" },
        { "type": "text", "id": "value_4", "label": "第 4 行内容" }
      ]
    }
  ],
  "max_blocks": 4,
  "presets": [
    { "name": "黑五机型对比", "category": "Black Friday" }
  ],
  "enabled_on": { "templates": ["page"] }
}
{% endschema %}
