{% render 'bfcm-assets' %}

<section class="bfcm bfcm--{{ section.settings.theme }}" {% if section.settings.anchor_id != blank %}id="{{ section.settings.anchor_id }}"{% endif %}>
  <div class="bfcm__inner">
    {% if section.settings.eyebrow != blank %}
      <p class="bfcm-kicker">{{ section.settings.eyebrow }}</p>
    {% endif %}
    <h2 class="bfcm-heading">{{ section.settings.heading }}</h2>
    {% if section.settings.text != blank %}
      <p class="bfcm-lead">{{ section.settings.text }}</p>
    {% endif %}
    <div class="bfcm-tiers">
      {% for block in section.blocks %}
        <article class="bfcm-tier" {{ block.shopify_attributes }}>
          {% if block.settings.kicker != blank %}
            <span>{{ block.settings.kicker }}</span>
          {% endif %}
          <strong>{{ block.settings.save }}</strong>
          <p>{{ block.settings.spend }}</p>
        </article>
      {% endfor %}
    </div>
    {% if section.settings.footnote != blank %}
      <p class="bfcm-footnote">{{ section.settings.footnote }}</p>
    {% endif %}
  </div>
</section>

{% schema %}
{
  "name": "黑五阶梯优惠",
  "tag": "div",
  "class": "bfcm-section",
  "settings": [
    { "type": "text", "id": "anchor_id", "label": "锚点 ID", "default": "tiers" },
    {
      "type": "select",
      "id": "theme",
      "label": "配色",
      "options": [
        { "value": "dark", "label": "深色" },
        { "value": "light", "label": "浅色" },
        { "value": "paper", "label": "浅灰" }
      ],
      "default": "dark"
    },
    { "type": "text", "id": "eyebrow", "label": "眉题", "default": "Tiered savings" },
    { "type": "text", "id": "heading", "label": "标题", "default": "Spend more, save more" },
    { "type": "textarea", "id": "text", "label": "说明", "default": "Replace these amounts with the discount you create in Shopify. This section does not apply a discount by itself." },
    { "type": "textarea", "id": "footnote", "label": "脚注", "default": "One promotional discount per order, unless you publish a different rule." }
  ],
  "blocks": [
    {
      "type": "tier",
      "name": "档位",
      "settings": [
        { "type": "text", "id": "kicker", "label": "眉题", "default": "Spend" },
        { "type": "text", "id": "spend", "label": "门槛", "default": "$1,000" },
        { "type": "text", "id": "save", "label": "优惠", "default": "Save $100" }
      ]
    }
  ],
  "max_blocks": 8,
  "presets": [
    { "name": "黑五阶梯优惠", "category": "Black Friday" }
  ],
  "enabled_on": { "templates": ["page"] }
}
{% endschema %}
