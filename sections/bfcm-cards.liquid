{% render 'bfcm-assets' %}

<section class="bfcm bfcm--{{ section.settings.theme }}" {% if section.settings.anchor_id != blank %}id="{{ section.settings.anchor_id }}"{% endif %}>
  <div class="bfcm__inner">
    {% if section.settings.eyebrow != blank %}
      <p class="bfcm-kicker">{{ section.settings.eyebrow }}</p>
    {% endif %}
    <h2 class="bfcm-heading">{{ section.settings.heading }}</h2>
    {% if section.settings.text != blank %}
      <p class="bfcm-lead">{{ section.settings.text }}</p>
    {% endif %}
    <div class="bfcm-grid bfcm-grid--{{ section.settings.columns }}">
      {% for block in section.blocks %}
        <article class="bfcm-mini" {{ block.shopify_attributes }}>
          {% if block.settings.kicker != blank %}
            <span>{{ block.settings.kicker }}</span>
          {% endif %}
          <h3>{{ block.settings.title }}</h3>
          {% if block.settings.text != blank %}
            <p>{{ block.settings.text }}</p>
          {% endif %}
          {% if block.settings.link_label != blank %}
            <div class="bfcm-actions">
              <a class="bfcm-btn bfcm-btn--ghost" href="{% if block.settings.product != blank %}{{ block.settings.product.url }}{% else %}{{ block.settings.link }}{% endif %}">{{ block.settings.link_label }}</a>
            </div>
          {% endif %}
        </article>
      {% endfor %}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "黑五卡片",
  "tag": "div",
  "class": "bfcm-section",
  "settings": [
    { "type": "text", "id": "anchor_id", "label": "锚点 ID" },
    {
      "type": "select",
      "id": "theme",
      "label": "配色",
      "options": [
        { "value": "dark", "label": "深色" },
        { "value": "light", "label": "浅色" },
        { "value": "paper", "label": "浅灰" }
      ],
      "default": "paper"
    },
    { "type": "text", "id": "eyebrow", "label": "眉题" },
    { "type": "text", "id": "heading", "label": "标题", "default": "Your support plan" },
    { "type": "textarea", "id": "text", "label": "说明" },
    {
      "type": "select",
      "id": "columns",
      "label": "列数",
      "options": [
        { "value": "2", "label": "2" },
        { "value": "3", "label": "3" },
        { "value": "4", "label": "4" }
      ],
      "default": "4"
    }
  ],
  "blocks": [
    {
      "type": "card",
      "name": "卡片",
      "settings": [
        { "type": "text", "id": "kicker", "label": "眉题" },
        { "type": "text", "id": "title", "label": "标题", "default": "Book a demo" },
        { "type": "textarea", "id": "text", "label": "说明" },
        { "type": "text", "id": "link_label", "label": "链接文字" },
        { "type": "text", "id": "link", "label": "链接", "info": "如果选择了商品，按钮会打开那个商品，这里的链接会被忽略。" },
        { "type": "product", "id": "product", "label": "关联商品" }
      ]
    }
  ],
  "max_blocks": 8,
  "presets": [
    { "name": "黑五卡片", "category": "Black Friday" }
  ],
  "enabled_on": { "templates": ["page"] }
}
{% endschema %}
