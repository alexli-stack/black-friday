{% render 'bfcm-assets' %}

{% assign today = 'now' | date: '%Y-%m-%d' %}
{% assign active_index = 0 %}
{% for block in section.blocks %}
  {% if active_index == 0 and block.settings.start_date != blank and block.settings.end_date != blank %}
    {% if block.settings.start_date <= today and today <= block.settings.end_date %}
      {% assign active_index = forloop.index %}
    {% endif %}
  {% endif %}
{% endfor %}
{% if active_index == 0 %}
  {% assign active_index = 1 %}
{% endif %}

<section class="bfcm bfcm--{{ section.settings.theme }}" {% if section.settings.anchor_id != blank %}id="{{ section.settings.anchor_id }}"{% endif %} data-bfcm-tabs>
  <div class="bfcm__inner">
    {% if section.settings.eyebrow != blank %}
      <p class="bfcm-kicker">{{ section.settings.eyebrow }}</p>
    {% endif %}
    <h2 class="bfcm-heading">{{ section.settings.heading }}</h2>
    {% if section.settings.text != blank %}
      <p class="bfcm-lead">{{ section.settings.text }}</p>
    {% endif %}
    <div class="bfcm-weeks__tabs" role="tablist">
      {% for block in section.blocks %}
        <button class="bfcm-week-tab{% if forloop.index == active_index %} is-active{% endif %}" type="button" role="tab" id="bfcm-week-tab-{{ section.id }}-{{ forloop.index }}" data-tab="{{ forloop.index }}" aria-selected="{% if forloop.index == active_index %}true{% else %}false{% endif %}" aria-controls="bfcm-week-panel-{{ section.id }}-{{ forloop.index }}" {{ block.shopify_attributes }}>
          {{ block.settings.title }}
          <small>{{ block.settings.date_label }}</small>
        </button>
      {% endfor %}
    </div>
    {% for block in section.blocks %}
      <div class="bfcm-week-panel{% if forloop.index == active_index %} is-active{% endif %}" id="bfcm-week-panel-{{ section.id }}-{{ forloop.index }}" role="tabpanel" data-panel="{{ forloop.index }}" aria-labelledby="bfcm-week-tab-{{ section.id }}-{{ forloop.index }}" {% if forloop.index != active_index %}hidden{% endif %}>
        <div>
          {% if block.settings.kicker != blank %}
            <p class="bfcm-kicker">{{ block.settings.kicker }}</p>
          {% endif %}
          <h3 class="bfcm-heading">{{ block.settings.heading }}</h3>
          {% if block.settings.text != blank %}
            <p class="bfcm-lead">{{ block.settings.text }}</p>
          {% endif %}
          {% if block.settings.time_note != blank %}
            <p class="bfcm-footnote">{{ block.settings.time_note }}</p>
          {% endif %}
          {% if today > block.settings.end_date and block.settings.end_date != blank %}
            <p class="bfcm-footnote">{{ section.settings.ended_text }}</p>
          {% endif %}
          {% if block.settings.button_label != blank %}
            <div class="bfcm-actions">
              <a class="bfcm-btn" href="{{ block.settings.button_link }}">{{ block.settings.button_label }}</a>
            </div>
          {% endif %}
        </div>
        {% if block.settings.product != blank %}
          {% if block.settings.product.featured_image != blank %}
            <a href="{{ block.settings.product.url }}">
              {{ block.settings.product.featured_image | image_url: width: 900 | image_tag: widths: '320, 520, 800', sizes: '(min-width: 980px) 30vw, 90vw', loading: 'lazy', alt: block.settings.product.title }}
            </a>
          {% endif %}
        {% endif %}
      </div>
    {% endfor %}
  </div>
</section>

{% schema %}
{
  "name": "黑五每周活动",
  "tag": "div",
  "class": "bfcm-section",
  "settings": [
    { "type": "text", "id": "anchor_id", "label": "锚点 ID", "default": "weeks" },
    {
      "type": "select",
      "id": "theme",
      "label": "配色",
      "options": [
        { "value": "dark", "label": "深色" },
        { "value": "light", "label": "浅色" },
        { "value": "paper", "label": "浅灰" }
      ],
      "default": "paper"
    },
    { "type": "text", "id": "eyebrow", "label": "眉题", "default": "Week by week" },
    { "type": "text", "id": "heading", "label": "标题", "default": "Holiday season prep, week after week" },
    { "type": "textarea", "id": "text", "label": "说明", "default": "Rotating spotlights through the month. The week that contains today opens first." },
    { "type": "text", "id": "ended_text", "label": "过期提示", "default": "This week has ended." }
  ],
  "blocks": [
    {
      "type": "week",
      "name": "一周",
      "settings": [
        { "type": "text", "id": "title", "label": "周名称", "default": "Desktop Week" },
        { "type": "text", "id": "date_label", "label": "日期显示", "default": "Nov 2 – Nov 8" },
        { "type": "text", "id": "start_date", "label": "开始日期", "default": "2026-11-02", "info": "格式 YYYY-MM-DD，用来判断本周是否正在进行。" },
        { "type": "text", "id": "end_date", "label": "结束日期", "default": "2026-11-08" },
        { "type": "text", "id": "kicker", "label": "卡片眉题", "default": "Thursday window" },
        { "type": "text", "id": "heading", "label": "卡片标题", "default": "Flagship desktop" },
        { "type": "textarea", "id": "text", "label": "卡片说明" },
        { "type": "text", "id": "time_note", "label": "时间备注", "default": "7:00 PM Pacific Time" },
        { "type": "text", "id": "button_label", "label": "按钮", "default": "Shop this week" },
        { "type": "text", "id": "button_link", "label": "按钮链接", "default": "#machines", "info": "页内锚点写成 #machines，外链写成完整网址。" },
        { "type": "product", "id": "product", "label": "本周商品" }
      ]
    }
  ],
  "max_blocks": 8,
  "presets": [
    { "name": "黑五每周活动", "category": "Black Friday" }
  ],
  "enabled_on": { "templates": ["page"] }
}
{% endschema %}
