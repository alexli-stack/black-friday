{% javascript %}
(()=>{const init=root=>{if(root.dataset.ready)return;root.dataset.ready='true';const filters=root.querySelectorAll('[data-filter]');filters.forEach(button=>button.addEventListener('click',()=>{filters.forEach(b=>b.setAttribute('aria-pressed',String(b===button)));root.querySelectorAll('[data-family]').forEach(card=>{card.hidden=button.dataset.filter!=='all'&&card.dataset.family!==button.dataset.filter});}));const form=root.querySelector('[data-search-form]'),input=form.querySelector('input'),panel=root.querySelector('[data-results]'),list=panel.querySelector('ul'),status=panel.querySelector('[data-status]');const normalize=s=>s.toLowerCase().normalize('NFKC').replace(/[^\p{L}\p{N}]+/gu,' ').trim();const search=()=>{const q=input.value.trim();if(!q){input.focus();return}const tokens=normalize(q).split(/\s+/);const entries=[...root.querySelectorAll('[data-searchable]')].map(a=>({title:a.dataset.searchTitle||a.textContent.trim().replace(/\s+/g,' '),text:normalize(a.textContent+' '+(a.dataset.keywords||'')),href:a.href}));const seen=new Set;const matches=entries.filter(e=>tokens.every(t=>e.text.includes(t))).filter(e=>{if(seen.has(e.href))return false;seen.add(e.href);return true});list.replaceChildren();for(const item of matches){const li=document.createElement('li'),a=document.createElement('a');a.href=item.href;a.textContent=item.title+' →';li.append(a);list.append(li)}status.textContent=matches.length?(panel.dataset.matchLabel||'{count} resources for “{query}”').replace('{count}',matches.length).replace('{query}',q):(panel.dataset.emptyLabel||'No matching resources for “{query}”. Try a model name or browse the full Wiki.').replace('{query}',q);panel.hidden=false;panel.scrollIntoView({behavior:matchMedia('(prefers-reduced-motion: reduce)').matches?'auto':'smooth',block:'nearest'});};form.addEventListener('submit',event=>{event.preventDefault();search()});root.querySelectorAll('[data-query]').forEach(b=>b.addEventListener('click',()=>{input.value=b.dataset.query;search()}));root.querySelector('[data-close-search]').addEventListener('click',()=>{panel.hidden=true;input.focus()});};document.querySelectorAll('.onelaser-support').forEach(init);document.addEventListener('shopify:section:load',e=>{if(e.target.matches('.onelaser-support'))init(e.target);e.target.querySelectorAll('.onelaser-support').forEach(init)});})();

{% endjavascript %}
