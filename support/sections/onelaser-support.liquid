{% stylesheet %}
.onelaser-support{--orange:#e7310e;--ink:#1c1c1c;--muted:#696969;--line:#e6e6e6;font-family:Arial,Helvetica,sans-serif;color:var(--ink);background:#fff;line-height:1.5;font-size:15px}.onelaser-support *{box-sizing:border-box}.onelaser-support a{color:inherit;text-decoration:none}.onelaser-support button,.onelaser-support input{font:inherit}.onelaser-support button,.onelaser-support a{ -webkit-tap-highlight-color:transparent}.onelaser-support a:focus-visible,.onelaser-support button:focus-visible,.onelaser-support input:focus-visible,.onelaser-support summary:focus-visible{outline:3px solid var(--orange);outline-offset:5px}.ol-wrap{max-width:1240px;margin:auto;padding:0 36px}.ol-eyebrow{font-size:11px;font-weight:700;letter-spacing:2px;text-transform:uppercase}.ol-accent{color:var(--orange)}.ol-header{height:86px;display:flex;align-items:center;justify-content:space-between;border-bottom:1px solid var(--line)}.ol-header img{width:156px;height:auto}.ol-nav{display:flex;gap:32px;align-items:center;font-size:13px}.ol-nav .active{color:var(--orange)}.ol-btn{display:inline-flex;gap:24px;justify-content:center;align-items:center;padding:13px 21px;border:1px solid var(--ink);background:var(--ink);color:#fff!important;font-weight:600;font-size:13px;cursor:pointer;border-radius:4px}.ol-btn.orange{background:var(--orange);border-color:var(--orange)}.ol-btn.light{background:#fff;color:var(--ink)!important;border-color:#d6d6d6}.ol-hero{background:#f5f5f5;overflow:hidden;position:relative}.ol-hero-grid{min-height:415px;display:grid;grid-template-columns:1.15fr 1fr;align-items:center;gap:20px;position:relative}.ol-hero h1{font-size:58px;line-height:1.06;letter-spacing:-2.6px;margin:17px 0 20px;font-weight:700}.ol-hero p{color:var(--muted);max-width:410px;font-size:15px}.ol-hero-art{position:relative;height:360px;display:flex;align-items:center;justify-content:center}.ol-hero-art:before{content:"";position:absolute;width:290px;height:290px;border:1px solid #ddd;border-radius:50%;bo