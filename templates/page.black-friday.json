      "type": "bfcm-faq",
      "blocks": {
        "faq-1": { "type": "faq", "settings": { "question": "Which products are in the promotion?", "answer": "<p>The machines, accessories, and gift cards on this page. Open a product for the full description, current price, and inventory.</p>" } },
        "faq-2": { "type": "faq", "settings": { "question": "When does each week change?", "answer": "<p>The schedule lists the dates. The week that contains today is open. After the end date, that tab shows the closed message.</p>" } },
        "faq-3": { "type": "faq", "settings": { "question": "Are the prices on this page final?", "answer": "<p>Cards show the current store price. If a product has a compare-at price, the previous price sits beside it. Checkout charges the price on the product.</p>" } },
        "faq-4": { "type": "faq", "settings": { "question": "Can I combine offers?", "answer": "<p>Plan on one promotional discount per order. If you publish a different stacking rule, replace this answer.</p>" } },
        "faq-5": { "type": "faq", "settings": { "question": "Do you offer financing?", "answer": "<p>If a financing app is enabled, it appears at checkout. Approval, rates, and terms come from that provider.</p>" } },
        "faq-6": { "type": "faq", "settings": { "question": "How do I choose a machine?", "answer": "<p>Use the comparison: XRF for a desktop RF bed, Cobra for workshop glass-tube cutting, Hydra Gen 2 for industrial cabinets, VertiGo for drinkware. Book a consultation if you want a person to walk through it.</p>" } },
        "faq-7": { "type": "faq", "settings": { "question": "Can these CO2 machines cut bare metal?", "answer": "<p>Bare metal is not listed as a cut material. The materials table is a starting point for wood, acrylic, leather, paper, coated metal, and tumblers. Check the product page before you buy for a metal job.</p>" } }
